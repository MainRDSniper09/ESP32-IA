{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MainRDSniper09/ESP32-IA/docs/schema/plan.schema.json",
  "title": "Plan del Agente ESP32-S3",
  "description": "Formato que el LLM debe devolver y que el firmware valida (PlanValidator.cpp). El firmware además verifica reglas semánticas que este esquema no puede expresar: after_step debe apuntar a un paso anterior, las consultas no se programan, fechas reales, etc. Ver docs/JSON_FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "plan",
        "clarification",
        "unsupported"
      ]
    },
    "summary": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        }
      },
      "then": {
        "required": [
          "steps"
        ],
        "not": {
          "required": [
            "question"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "clarification"
          }
        }
      },
      "then": {
        "required": [
          "question"
        ],
        "not": {
          "required": [
            "steps"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "steps"
          ]
        }
      }
    }
  ],
  "$defs": {
    "outputDevice": {
      "enum": [
        "luz_entrada",
        "luz_oficina",
        "luz_parqueadero",
        "luz_bodega",
        "aspersor_frontal",
        "aspersor_trasero"
      ]
    },
    "accessDevice": {
      "enum": [
        "puerta_principal",
        "puerta_bodega",
        "puerta_oficina",
        "ventana_oficina",
        "ventana_recepcion"
      ]
    },
    "accessTarget": {
      "anyOf": [
        {
          "enum": [
            "doors",
            "windows",
            "accesses"
          ]
        },
        {
          "$ref": "#/$defs/accessDevice"
        }
      ]
    },
    "onOff": {
      "enum": [
        "on",
        "off"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "set_device",
            "set_group",
            "read_access",
            "notify",
            "list_tasks",
            "cancel_task",
            "system_status"
          ]
        },
        "params": {
          "type": "object"
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_device"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device",
                  "state"
                ],
                "properties": {
                  "device": {
                    "$ref": "#/$defs/outputDevice"
                  },
                  "state": {
                    "$ref": "#/$defs/onOff"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_group"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "group",
                  "state"
                ],
                "properties": {
                  "group": {
                    "enum": [
                      "lights",
                      "sprinklers",
                      "all"
                    ]
                  },
                  "state": {
                    "$ref": "#/$defs/onOff"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "read_access"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target"
                ],
                "properties": {
                  "target": {
                    "$ref": "#/$defs/accessTarget"
                  },
                  "filter": {
                    "enum": [
                      "all",
                      "open",
                      "closed"
                    ]
                  }
                }
              },
              "when": false,
              "condition": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "notify"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "level": {
                    "enum": [
                      "info",
                      "warning",
                      "alert"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "list_tasks",
                  "system_status"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "maxProperties": 0
              },
              "when": false,
              "condition": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel_task"
              }
            }
          },
          "then": {
            "required": [
              "params"
            ],
            "properties": {
              "params": {
                "type": "object",
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "task_id"
                    ],
                    "properties": {
                      "task_id": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "not": {
                      "required": [
                        "all"
                      ]
                    }
                  },
                  {
                    "required": [
                      "all"
                    ],
                    "properties": {
                      "all": {
                        "const": true
                      }
                    },
                    "not": {
                      "required": [
                        "task_id"
                      ]
                    }
                  }
                ],
                "properties": {
                  "task_id": {
                    "type": "integer"
                  },
                  "all": {
                    "type": "boolean"
                  }
                }
              },
              "when": false,
              "condition": false
            }
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "now"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "time"
          ],
          "properties": {
            "type": {
              "const": "at"
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "date": {
              "type": "string",
              "pattern": "^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
            },
            "repeat": {
              "enum": [
                "none",
                "daily"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "delay"
            },
            "seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "step",
            "seconds"
          ],
          "properties": {
            "type": {
              "const": "after_step"
            },
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800
            }
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "all_closed",
            "any_open",
            "is_open",
            "is_closed"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "all_closed",
                "any_open"
              ]
            },
            "target": {
              "$ref": "#/$defs/accessTarget"
            }
          }
        },
        {
          "properties": {
            "type": {
              "enum": [
                "is_open",
                "is_closed"
              ]
            },
            "target": {
              "$ref": "#/$defs/accessDevice"
            }
          }
        }
      ]
    }
  }
}
